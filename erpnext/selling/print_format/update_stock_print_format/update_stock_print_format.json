 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n@page {\n    size: A4;\n    margin: 0;\n}\n\n* {\n    box-sizing: border-box;\n}\n\n.print-format1 {\n    width: 210mm;\n    height: 297mm;\n    position: relative;\n    background: white;\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    font-size: 13px;\n    color: #000;\n    margin: 0 auto;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n    overflow: hidden;\n}\n\n.print-format {\n    padding: 0 !important;\n}\n\n.page-content {\n    padding-top: 80px;\n    padding-left: 12mm;\n    padding-right: 12mm;\n    padding-bottom: 10mm;\n    height: 297mm;\n    overflow: hidden;\n}\n\n/* Header */\n.invoice-header {\n    text-align: center;\n    margin-bottom: 10px;\n    margin-top: 50px;\n}\n\n.invoice-header h2 {\n    margin: 0;\n    padding: 6px 0;\n    font-size: 20px;\n    font-weight: 700;\n    letter-spacing: 2px;\n \n}\n\n/* Main Container - Single outer border */\n.invoice-container {\n    border: 2px solid #000;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n}\n\n/* Two-column layout - no gap, shared border */\n.info-grid {\n    display: flex;\n    border-bottom: 2px solid #000;\n}\n\n.info-box {\n    flex: 1;\n    background: #fff;\n}\n\n.info-box:first-child {\n    border-right: 2px solid #000;\n}\n\n.info-box-title {\n    background: #e8e8e8;\n    padding: 5px 12px;\n    font-weight: 700;\n    font-size: 13px;\n    border-bottom: 2px solid #000;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n}\n\n.info-box-content {\n    padding: 8px 12px;\n}\n\n.info-box-content table {\n    width: 100%;\n    border-collapse: collapse;\n}\n\n.info-box-content td {\n    padding: 3px 0;\n    vertical-align: top;\n    line-height: 1.2;\n    font-size: 13px;\n}\n\n.info-box-content td b {\n    display: inline-block;\n    min-width: 85px;\n    font-weight: 600;\n}\n\n/* Item Section - no separate border, part of container */\n.item-section {\n    background: #fff;\n    border-bottom: 2px solid #000;\n    \n}\n\n.item-section-title {\n    background: #e8e8e8;\n    padding: 5px 12px;\n    font-weight: 700;\n    font-size: 13px;\n    border-bottom: 2px solid #000;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n}\n\n.item-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 12px;\n    \n}\n\n.item-table thead {\n    background: #f5f5f5;\n    border-bottom: 2px solid #000;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n}\n\n.item-table th {\n    padding: 5px 8px;\n    text-align: left;\n    font-weight: 700;\n    border-right: 2px solid black;\n    font-size: 12px;\n    \n}\n\n.item-table th:last-child {\n    border-right: none;\n}\n\n.item-table tbody tr {\n    \n}\n\n.item-table tbody tr:last-child {\n    border-bottom: none;\n}\n\n.item-table td {\n    padding: 4px 8px;\n    vertical-align: middle;\n    border-right: 2px solid black;\n    line-height: 1;\n}\n\n.item-table td:last-child {\n    border-right: none;\n}\n\n.item-table td:nth-child(4),\n.item-table td:nth-child(5),\n.item-table td:nth-child(6) {\n    text-align: right;\n}\n\n/* Bottom Section - Bank & Tax - shared borders */\n.bottom-grid {\n    display: flex;\n    border-bottom: 2px solid #000;\n}\n\n.bottom-box {\n    flex: 1;\n    background: #fff;\n}\n\n.bottom-box:first-child {\n    border-right: 2px solid #000;\n}\n\n.bottom-box-title {\n    background: #e8e8e8;\n    padding: 5px 12px;\n    font-weight: 700;\n    font-size: 13px;\n    border-bottom: 2px solid #000;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n}\n\n.bottom-box-content {\n    padding: 8px 12px;\n}\n\n.bottom-box-content table {\n    width: 100%;\n    border-collapse: collapse;\n}\n\n.bottom-box-content td {\n    padding: 3px 0;\n    vertical-align: top;\n    line-height: 1;\n    font-size: 13px;\n}\n\n.bottom-box-content td b {\n    display: inline-block;\n    min-width: 95px;\n    font-weight: 600;\n}\n\n.bottom-box-content tr:last-child td {\n    padding-top: 8px;\n    border-top: 1px solid #ddd;\n    font-weight: 700;\n    font-size: 13px;\n}\n\n/* Amount in Words - part of container */\n.words-section {\n    padding: 6px 12px;\n    background: #f9f9f9;\n    border-bottom: 2px solid #000;\n    font-size: 12px;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n}\n\n.words-section b {\n    font-weight: 700;\n    margin-right: 8px;\n}\n\n/* Footer - shared borders, no bottom border on container */\n.footer-grid {\n    display: flex;\n}\n\n.footer-box {\n    padding: 10px 12px;\n    background: #fff;\n}\n\n.footer-left {\n    flex: 1.5;\n    border-right: 2px solid #000;\n}\n\n.footer-right {\n    flex: 1;\n    text-align: right;\n}\n\n.footer-box strong {\n    display: block;\n    margin-bottom: 8px;\n    font-size: 13px;\n    font-weight: 700;\n}\n\n.footer-left div {\n    margin: 3px 0;\n    line-height: 1;\n    font-size: 11px;\n}\n\n.signature-area {\n    margin-top: 10px;\n    float: right;\n}\n\n.signature-area img {\n    display: block;\n    margin: 8px auto 5px auto;\n    width: 80px;\n    height: 40px;\n    object-fit: contain;\n}\n\n/* Print Optimization */\n@media print {\n    @page {\n        margin: 0;\n        size: A4;\n    }\n    \n    .print-format1 {\n        width: 210mm;\n        height: 297mm;\n        margin: 0;\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n        overflow: hidden !important;\n        page-break-after: avoid !important;\n    }\n    \n    .page-content {\n        padding-top: 80px;\n        padding-left: 12mm;\n        padding-right: 12mm;\n        padding-bottom: 10mm;\n        height: 297mm;\n        overflow: hidden !important;\n        page-break-after: avoid !important;\n    }\n    \n    /* Ensure borders print dark */\n    .invoice-container,\n    .info-grid,\n    .info-box:first-child,\n    .info-box-title,\n    .item-section,\n    .item-section-title,\n    \n    .item-table thead,\n    .bottom-grid,\n    .bottom-box:first-child,\n    .bottom-box-title,\n    .words-section,\n    .footer-left {\n        border-color:black !important;\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n    }\n    \n    /* Force background colors to print */\n    .info-box-title,\n    .item-section-title,\n    .bottom-box-title,\n    .item-table thead,\n    .words-section {\n        background-color: #e8e8e8 !important;\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n    }\n    \n    \n    /* Prevent page breaks */\n    * {\n        page-break-inside: avoid !important;\n        page-break-after: avoid !important;\n    }\n    \n    /* Keep signature image small in print */\n    .signature-area img {\n        width: 80px !important;\n        height: 40px !important;\n        max-width: 80px !important;\n        max-height: 40px !important;\n        \n    }\n}\n</style>\n\n<div class=\"print-format1\">\n    <div class=\"page-content\">\n        \n        <!-- Header -->\n        <div class=\"invoice-header\">\n            <h2>TAX INVOICE</h2>\n        </div>\n\n        {% set customer_doc = frappe.get_doc(\"Customer\", doc.customer) %}\n        \n        <!-- Single container with shared borders -->\n        <div class=\"invoice-container\">\n            \n            <!-- Customer & Invoice Details -->\n            <div class=\"info-grid\">\n                <div class=\"info-box\">\n                    <div class=\"info-box-title\">Customer Details</div>\n                    <div class=\"info-box-content\">\n                        <table>\n                            <tr>\n                                <td><b>Name: {{ doc.customer_name }} </b> </td>\n                            </tr>\n                            <tr>\n                                <td style=\"line-height:1.4!important\"><b>Address:</b> {{ doc.address_display | replace(\"<br>\", \", \") }}</td>\n                            </tr>\n                            <tr>\n                                <td><b>GST No:</b> {{ customer_doc.gstin or \"N/A\" }}</td>\n                            </tr>\n                        </table>\n                    </div>\n                </div>\n\n                <div class=\"info-box\">\n                    <div class=\"info-box-title\">Invoice Details</div>\n                    <div class=\"info-box-content\">\n                        <table>\n                            <tr>\n                                <td><b>Invoice No: {{ doc.name }} </b> </td>\n                            </tr>\n                            <tr>\n                                <td><b>Invoice Date:</b> {{ frappe.utils.formatdate(doc.posting_date) }}</td>\n                            </tr>\n                            <tr>\n                                <td><b>Challan No:</b> {{ doc.delivery_challan or \"N/A\" }}</td>\n                            </tr>\n                            <tr>\n                                <td><b>Due Date:</b> {{ frappe.utils.formatdate(doc.due_date) }}</td>\n                            </tr>\n                        </table>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Item Details -->\n            <div class=\"item-section\">\n                <div class=\"item-section-title\">Item Details</div>\n                <table class=\"item-table\">\n                    <thead>\n                        <tr>\n                            <th style=\"width: 5%;\">Sr</th>\n                            <th style=\"width: 45%;\">Description</th>\n                            <th style=\"width: 12%;\">HSN/SAC</th>\n                            <th style=\"width: 8%;\">Qty</th>\n                            <th style=\"width: 12%;\">Rate</th>\n                            <th style=\"width: 18%;\">Amount</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for i in range(12) %}\n                            {% if doc.items[i] and doc.items[i].item_name != 'Freight Charges' %}\n                                <tr>\n                                    <td>{{ i + 1 }}</td>\n                                    <td>{{ doc.items[i].item_name }}</td>\n                                    <td>{{ doc.items[i].gst_hsn_code }}</td>\n                                    <td>{{ doc.items[i].qty }}</td>\n                                    <td>\u20b9 {{ \"{:,.2f}\".format(doc.items[i].rate) }}</td>\n                                    <td >\u20b9 {{ \"{:,.2f}\".format(doc.items[i].amount) }}</td>\n                                </tr>\n                            {% else %}\n                                <tr>\n                                    <td>&nbsp;</td>\n                                    <td>&nbsp;</td>\n                                    <td>&nbsp;</td>\n                                    <td>&nbsp;</td>\n                                    <td>&nbsp;</td>\n                                    <td>&nbsp;</td>\n                                </tr>\n                            {% endif %}\n                        {% endfor %}\n                    </tbody>\n                </table>\n            </div>\n\n            {% set ns = namespace(sgst=0, cgst=0) %}\n            {% for tax in doc.taxes %}\n                {% if \"SGST\" in (tax.account_head or \"\") or \"SGST\" in (tax.description or \"\") %}\n                    {% set ns.sgst = ns.sgst + tax.tax_amount %}\n                {% endif %}\n                {% if \"CGST\" in (tax.account_head or \"\") or \"CGST\" in (tax.description or \"\") %}\n                    {% set ns.cgst = ns.cgst + tax.tax_amount %}\n                {% endif %}\n            {% endfor %}\n\n            {% set company_doc = frappe.get_doc(\"Company\", doc.company) %}   \n            {% set account_doc = frappe.get_doc(\"Account\", company_doc.default_bank_account) %}\n            \n            <!-- Bank & Tax Details -->\n            <div class=\"bottom-grid\">\n                <div class=\"bottom-box\">\n                    <div class=\"bottom-box-title\">Bank and Company Details</div>\n                    <div class=\"bottom-box-content\">\n                        <table>\n                            <tr>\n                                <td><b>Bank Name:</b> </td>\n                                <td> <b> {{ account_doc.account_name }} </b> </td>\n                            </tr>\n                            <tr>\n                                <td><b>IFSC:</b> </td> \n                                <td> <b> {{ account_doc.ifsc_code }} </b></td>\n                            </tr>\n                            <tr>\n                                <td><b>A/C No:</b> </td>\n                                <td> <b> {{ account_doc.account_number }} </b></td>\n                            </tr>\n                            <tr>\n                                <td><b>Branch:</b> </td>\n                                <td> <b> {{ account_doc.branch }} </b></td>\n                            </tr>\n                            <tr>\n                                <td><b>Our GSTIN:</b> </td>\n                                <td><b>{{ company_doc.gstin }} </b></td>\n                            </tr>\n                            <tr>\n                                <td><b>MSME:</b> </td>\n                                <td>{{ company_doc.msme }}</td>\n                            </tr>\n                            \n                        </table>\n                    </div>\n                </div>\n\n                <div class=\"bottom-box\">\n                    <div class=\"bottom-box-title\">Sub Total \n                    <span style=\"text-align: right;padding-left:170px\"> \u20b9 {{ \"{:,.2f}\".format(doc.net_total - doc.freight) }} </span>\n                    </div>\n                    <div class=\"bottom-box-content\">\n                        <table>\n                            <tr>\n                                <td style=\"line-height:1.6 !important\"><b>Frieght</b></td>\n                                <td style=\"text-align: right;\">\u20b9 {{ \"{:,.2f}\".format(doc.freight) }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"line-height:1.6 !important\"><b>SGST</b></td>\n                                <td style=\"text-align: right;\">\u20b9 {{ \"{:,.2f}\".format(ns.sgst) }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"line-height:1.6 !important\"><b>CGST</b></td>\n                                <td style=\"text-align: right;\">\u20b9 {{ \"{:,.2f}\".format(ns.cgst) }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"line-height:2.0 !important\"><b>Grand Total</b></td>\n                                <td style=\"text-align: right;\">\u20b9 {{ \"{:,.2f}\".format(doc.grand_total) }}</td>\n                            </tr>\n                            <tr>\n                                <td style=\"line-height:1.2 !important\"><b>Net Payable Amount</b></td>\n                                <td style=\"text-align: right;\">\u20b9 {{ \"{:,.2f}\".format(doc.rounded_total) }}</td>\n                            </tr>\n                        </table>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Amount in Words -->\n            <div class=\"words-section\">\n                <b>In Words: {{ doc.in_words }} </b>\n            </div>\n\n            <!-- Footer - Terms & Signature -->\n            <div class=\"footer-grid\">\n                <div class=\"footer-box footer-left\">\n                    <strong>Terms & Conditions</strong>\n                    <div>(1) We do not hold responsible for any breakage/damage/leakage in transit.</div>\n                    <div>(2) Our responsibility ceases when the goods are delivered to the carrier.</div>\n                    <div>(3) Goods once sold will not be accepted back.</div>\n                    <div>(4) Interest @ 24% p.a. will be charged, if invoice is not paid on or before due date.</div>\n                    <div>(5) Subject to Ahmedabad Jurisdiction.</div>\n                </div>\n                \n                <div class=\"footer-box footer-right\">\n                    <strong>For {{ company_doc.company_name }}</strong>\n                    <div class=\"signature-area\">\n                        <img src=\"{{ frappe.utils.get_url() }}/files/Veer_Sign.png\" alt=\"Signature\" />\n                        <div style=\"margin-top: 10px; font-weight: 600; font-size: 11px;\">Authorized Signatory</div>\n                    </div>\n                </div>\n            </div>\n            \n        </div>\n        <!-- End of invoice-container -->\n\n    </div>\n</div>",
